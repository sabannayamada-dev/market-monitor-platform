PATENT_TIMEZONE=Asia/Tokyo
PATENT_CONFIG_PATH=/opt/patent-news-monitor/app/patent_monitor_config.json
PATENT_COMPANY_MASTER=/opt/patent-news-monitor/app/patent_company_master.csv
PATENT_OUTPUT_DIR=/var/lib/patent-news-monitor/daily
PATENT_DB_PATH=/var/lib/patent-news-monitor/patent_monitor.sqlite3
PATENT_LOOKBACK_DAYS=3
PATENT_MAX_PER_COMPANY=100
PATENT_DAILY_GPT_LIMIT=40
PATENT_DAILY_GEMINI_LIMIT=10
PATENT_MONTHLY_GPT_LIMIT=500
PATENT_MONTHLY_GEMINI_LIMIT=500
PATENT_DAILY_DIGEST_ENABLED=true
PATENT_URGENT_NOTIFICATIONS_ENABLED=true

# Shared runtime used by patent, stock-bottom, and future monitors.
MONITOR_REGISTRY_PATH=/opt/patent-news-monitor/app/monitor_services.json
MONITOR_PLATFORM_STATE_DB=/var/lib/market-monitor/platform.sqlite3
MONITOR_PLATFORM_LOCK_DIR=/var/lib/market-monitor/locks

# GDELT rollout: 1=collection, 2=rule scoring, 3=AI-to-DB, 4=email.
GDELT_CONFIG_PATH=/opt/patent-news-monitor/app/gdelt_monitor_config.json
GDELT_COMPANY_MASTER=/opt/patent-news-monitor/app/patent_company_master.csv
GDELT_STATE_DB=/var/lib/gdelt-news-monitor/gdelt_monitor.sqlite3
GDELT_OPERATION_STAGE=1

# Required for EPO collection
EPO_OPS_KEY=replace_me
EPO_OPS_SECRET=replace_me

# Optional until AI review is enabled
OPENAI_API_KEY=replace_me
GEMINI_API_KEY=replace_me

# Gmail SMTP does not require a mail API. Use a Google app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_address@gmail.com
SMTP_PASSWORD=replace_with_app_password
EMAIL_RECIPIENT=your_address@gmail.com
