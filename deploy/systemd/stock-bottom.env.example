STOCK_BOTTOM_APP_PATH=/opt/patent-news-monitor/app/app.py
STOCK_CACHE_DB=/var/lib/stock-bottom-monitor/stock_cache.db
STOCK_BOTTOM_STATE_DB=/var/lib/stock-bottom-monitor/notifications.sqlite3
STOCK_BOTTOM_WORKERS=3
STOCK_BOTTOM_MAX_RUNTIME_MINUTES=180
STOCK_BOTTOM_SIGNAL_MAX_AGE_DAYS=10

MONITOR_REGISTRY_PATH=/opt/patent-news-monitor/app/monitor_services.json
MONITOR_PLATFORM_STATE_DB=/var/lib/market-monitor/platform.sqlite3
MONITOR_PLATFORM_LOCK_DIR=/var/lib/market-monitor/locks

# Reuses SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD and EMAIL_RECIPIENT
# from /etc/patent-news-monitor.env.
