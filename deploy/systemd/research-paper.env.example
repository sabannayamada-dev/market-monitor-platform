# Dedicated research-paper paths and rollout stage.
PAPER_CONFIG_PATH=/opt/patent-news-monitor/app/research_paper_config.json
PAPER_STATE_DB=/var/lib/research-paper-monitor/research_papers.sqlite3
PAPER_OPERATION_STAGE=1

# Recommended free OpenAlex key. Keep the actual value only in /etc/patent-news-monitor.env.
OPENALEX_API_KEY=

# Stage 3 uses the existing OPENAI_API_KEY. Stage 4 uses the existing SMTP_* settings.
